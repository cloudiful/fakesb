{
  "db_name": "PostgreSQL",
  "query": "select l.id,\n       l.occurred_at,\n       l.rule_id,\n       l.target_id,\n       l.action,\n       l.method,\n       l.path,\n       l.query_string,\n       l.content_type,\n       l.body_format,\n       l.request_headers,\n       l.response_headers,\n       l.http_status_code,\n       l.latency_ms,\n       l.error_message,\n       coalesce(\n           json_agg(\n               json_build_object(\n                   'id', s.id,\n                   'kind', s.kind,\n                   'raw_body', s.raw_body,\n                   'normalized_json', s.normalized_json\n               ) order by s.id\n           ) filter (where s.id is not null),\n           '[]'::json\n       ) as snapshots\nfrom request_logs l\nleft join message_snapshots s on s.log_id = l.id\nwhere l.id = $1\ngroup by l.id\n",
