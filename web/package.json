{
  "name": "fakesb-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run --passWithNoTests",
    "api:generate": "bun run api:export && bunx openapi-typescript openapi.json -o types/api.generated.ts",
    "api:export": "cd ../server && cargo run --quiet -- export-openapi > ../web/openapi.json"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.4.1",
    "nuxt": "^4.5.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
